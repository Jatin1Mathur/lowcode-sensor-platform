# memory = local development, apex = forward to Oracle APEX (ORDS)
STORAGE_BACKEND=memory
APEX_ORDS_BASE_URL=https://apex.example.com/ords/sensor_ws/sensor
APEX_ORDS_TOKEN=
APEX_TIMEOUT_SECONDS=5
# Devices must send this in the X-API-Key header (leave empty to disable)
DEVICE_API_KEY=change-me
MAX_BATCH_SIZE=500
