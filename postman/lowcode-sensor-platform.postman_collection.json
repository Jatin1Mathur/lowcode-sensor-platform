{
  "info": {
    "name": "Low-Code Sensor Platform",
    "description": "Valid and malformed payloads for the Flask REST service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "apiKey", "value": "change-me" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 200', () => pm.response.to.have.status(200));"
      ]}}]
    },
    {
      "name": "Sensor catalog (17 sensors)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/sensors" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('17 sensors', () => pm.expect(pm.response.json().count).to.eql(17));"
      ]}}]
    },
    {
      "name": "Valid cycle",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/readings",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{apiKey}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"device_id\": \"esp32-rig-01\",\n  \"cycle\": {{$randomInt}},\n  \"timestamp\": \"2026-11-06T08:00:00Z\",\n  \"readings\": {\"PS1\": 160.4, \"TS1\": 45.2, \"VS1\": 0.61, \"FS1\": 6.8}\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 201', () => pm.response.to.have.status(201));"
      ]}}]
    },
    {
      "name": "Malformed: missing field, wrong type, out of range",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/readings",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{apiKey}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"device_id\": \"esp32-rig-01\",\n  \"cycle\": \"seven\",\n  \"readings\": {\"PS1\": 999, \"TS1\": \"hot\", \"XX9\": 1}\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 400', () => pm.response.to.have.status(400));",
        "pm.test('lists every problem', () => pm.expect(pm.response.json().error.details.length).to.be.at.least(5));"
      ]}}]
    },
    {
      "name": "Malformed: invalid JSON",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/readings",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-API-Key", "value": "{{apiKey}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"device_id\": \"esp32-rig-01\", " }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 400', () => pm.response.to.have.status(400));",
        "pm.test('invalid_json', () => pm.expect(pm.response.json().error.code).to.eql('invalid_json'));"
      ]}}]
    },
    {
      "name": "Missing API key",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/readings",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('status 401', () => pm.response.to.have.status(401));"
      ]}}]
    },
    {
      "name": "List cycles",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/cycles?device_id=esp32-rig-01&limit=20" }
    }
  ]
}
